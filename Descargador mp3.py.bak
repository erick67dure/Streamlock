"""
MúsicApp — Reproductor + Descargador (Edición UI Spotify)
=========================================================
• Playlists reales desde carpeta ./Playlists/
• Buscador de YouTube integrado en la vista de Descarga
• Interfaz moderna, minimalista y fluida
"""
import customtkinter as ctk
import pygame
import os
import random
import re
import threading
from tkinter import messagebox
import concurrent.futures

# ══════════════════════════════════════════════
#  PALETA DE COLORES "PREMIUM DARK"
# ══════════════════════════════════════════════
C_FONDO       = "#0A0A0C"  # Negro ultra profundo para el fondo principal
C_SIDEBAR     = "#000000"  # Negro puro para la barra lateral
C_PLAYER      = "#050505"  # Negro casi puro para el reproductor inferior
C_PANEL       = "#121216"  # Gris ultra oscuro para tarjetas interiores
C_CARD        = "#18181C"  # Tarjetas de playlists
C_CARD_HOVER  = "#24242A"  # Hover de tarjetas
C_ACTIVA      = "#2D1022"  # Tinte magenta sutil para la canción sonando
C_ACENTO      = "#E91E63"  # Magenta vibrante
C_ACENTO_H    = "#F06292"  # Magenta hover
C_ACENTO_VIV  = "#FF80AB"  # Rosa brillante para el ecualizador
C_TEXTO       = "#FFFFFF"  # Blanco puro para textos principales
C_TEXTO_SUB   = "#A0A0A0"  # Gris claro para subtítulos
C_TEXTO_GRIS  = "#666666"  # Gris oscuro para info secundaria
C_TEXTO_NUM   = "#555555"  # Gris para números de lista
C_SEP         = "#1F1F24"  # Líneas de separación sutiles
C_ENTRY_BG    = "#141418"  # Fondo de barras de búsqueda

def F(size: int, weight: str = "normal") -> ctk.CTkFont:
    for fam in ("Segoe UI", "Roboto", "Helvetica Neue", "Arial"):
        try:
            return ctk.CTkFont(family=fam, size=size, weight=weight)
        except Exception:
            pass
    return ctk.CTkFont(size=size, weight=weight)

SIDEBAR_W   = 220
SIDEBAR_MIN = 60
PLAYER_H    = 95
ROW_H       = 50

SONG_END    = pygame.USEREVENT + 1

import sys
if getattr(sys, 'frozen', False):
    _BASE_PATH = os.path.dirname(os.path.realpath(sys.executable))
else:
    _BASE_PATH = os.path.dirname(os.path.realpath(__file__))

PLAYLISTS_DIR = os.path.join(_BASE_PATH, "Playlists")
FFMPEG_PATH   = os.path.join(_BASE_PATH, "ffmpeg.exe")
os.makedirs(PLAYLISTS_DIR, exist_ok=True)


# ══════════════════════════════════════════════
#  APP
# ══════════════════════════════════════════════
class ReproductorApp(ctk.CTk):

    def __init__(self):
        super().__init__()
        self.title("StreamLock")
        self.geometry("1080x720")
        try:
            self.iconbitmap("logo.ico") # Asegurate de que el archivo se llame así y esté en la misma carpeta
        except Exception:
            pass # Si no encuentra el logo, no crashea el programa

        self.minsize(800, 600)
        self.configure(fg_color=C_FONDO)

        pygame.init()
        pygame.mixer.init()
        pygame.mixer.music.set_endevent(SONG_END)

        self._playing    = False
        self._loop       = False
        self._shuffle    = False
        self._cur_idx    = -1
        self._playlist   = []
        self._duration   = 0.0
        self._pos        = 0.0
        self._seeking              = False
        self.inicio_tiempo_actual  = 0.0

        self._sidebar_open  = True
        self._transitioning = False
        self._cur_view      = None
        self._row_refs               = []
        self._all_songs              = []
        self._current_playlist_name  = ""
        self._lbl_meta               = None

        self.cookies_file = os.path.join(_BASE_PATH, "cookies.txt")
        self._thread_pool = concurrent.futures.ThreadPoolExecutor(max_workers=4)

        self._build_ui()
        self.playlists = {}
        self._show_selection(animated=False)

        self.after(60, self._enforce_z)
        self._tick_bars()
        self._pygame_loop()
        self.actualizar_barra()
        self.after(100, self.cargar_playlists)

    # ══════════════════════════════════════════
    #  CONSTRUCCIÓN DE UI
    # ══════════════════════════════════════════
    def _build_ui(self):
        self._top = ctk.CTkFrame(self, fg_color="transparent")
        self._top.pack(fill="both", expand=True)
        self._build_sidebar()
        self._build_content()
        self._build_player()
        self._build_refresh_btn()

    def _build_sidebar(self):
        self.sidebar = ctk.CTkFrame(self._top, width=SIDEBAR_W, fg_color=C_SIDEBAR, corner_radius=0)
        self.sidebar.pack(side="left", fill="y")
        self.sidebar.pack_propagate(False)

        row = ctk.CTkFrame(self.sidebar, fg_color="transparent")
        row.pack(fill="x", padx=16, pady=(24, 0))

        self.btn_menu = ctk.CTkButton(row, text="☰", width=36, height=36,
            fg_color="transparent", hover_color=C_CARD, font=F(20),
            text_color=C_TEXTO, corner_radius=18, command=self._toggle_sidebar)
        self.btn_menu.pack(side="left")

        self.lbl_logo = ctk.CTkLabel(row, text="StreamLock", font=F(16, "bold"), text_color=C_TEXTO)
        self.lbl_logo.pack(side="left", padx=(4,0))

        self._nav = ctk.CTkFrame(self.sidebar, fg_color="transparent")
        self._nav.pack(fill="x", padx=12, pady=(30, 0))

        self.btn_playlists = self._nav_btn("♫   Mis Playlists", self._goto_selection)
        self.btn_download  = self._nav_btn("↓   Descargar",     self._goto_download)

    def _nav_btn(self, text, cmd):
        b = ctk.CTkButton(self._nav, text=text, anchor="w", height=44,
            corner_radius=8, fg_color="transparent", hover_color=C_CARD,
            text_color=C_TEXTO_SUB, font=F(14, "bold"), command=cmd)
        b.pack(fill="x", pady=4)
        return b

    def _toggle_sidebar(self):
        if self._sidebar_open:
            self.lbl_logo.configure(text="")
            for b, ico in [(self.btn_playlists, "♫"), (self.btn_download, "↓")]:
                b.configure(text=ico, anchor="center")
            self.sidebar.configure(width=SIDEBAR_MIN)
            self._sidebar_open = False
        else:
            self.sidebar.configure(width=SIDEBAR_W)
            self.lbl_logo.configure(text=" StreamLock")
            for b, t in [(self.btn_playlists, "♫   Mis Playlists"), (self.btn_download, "↓   Descargar")]:
                b.configure(text=t, anchor="w")
            self._sidebar_open = True
        self._enforce_z()

    def _build_content(self):
        self.content = ctk.CTkFrame(self._top, fg_color=C_FONDO, corner_radius=0)
        self.content.pack(side="left", fill="both", expand=True)

    def _build_player(self):
        # Estilo moderno: Todo centrado, controles blancos, barra de progreso limpia
        self.player = ctk.CTkFrame(self, fg_color=C_PLAYER, corner_radius=0, height=PLAYER_H)
        self.player.pack(fill="x", side="bottom")
        self.player.pack_propagate(False)

        grid = ctk.CTkFrame(self.player, fg_color="transparent")
        grid.pack(fill="both", expand=True, padx=24, pady=10)

        # 1. Izquierda: Info de canción
        left_col = ctk.CTkFrame(grid, fg_color="transparent", width=250)
        left_col.pack(side="left", fill="y", expand=False)
        left_col.pack_propagate(False)

        self.lbl_song = ctk.CTkLabel(left_col, text="Sin reproducción", font=F(14, "bold"), text_color=C_TEXTO, anchor="w")
        self.lbl_song.pack(side="top", anchor="w", pady=(18,0))

        # 2. Centro: Controles + Progreso
        center_col = ctk.CTkFrame(grid, fg_color="transparent")
        center_col.pack(side="left", fill="both", expand=True, padx=20)

        ctrl_row = ctk.CTkFrame(center_col, fg_color="transparent")
        ctrl_row.pack(side="top", pady=(5, 5))

        self.btn_shuf = self._tog(ctrl_row, "⇄", self._toggle_shuffle)
        self._ctrl(ctrl_row, "⏮", self._prev, 18)
        self.btn_play = ctk.CTkButton(ctrl_row, text="▶", width=42, height=42, corner_radius=21,
            fg_color=C_TEXTO, hover_color=C_TEXTO_SUB, text_color=C_PLAYER,
            font=F(18, "bold"), border_width=0, command=self._toggle_play)
        self.btn_play.pack(side="left", padx=16)
        self._ctrl(ctrl_row, "⏭", self._next, 18)
        self.btn_loop = self._tog(ctrl_row, "↻", self._toggle_loop)

        prog_row = ctk.CTkFrame(center_col, fg_color="transparent")
        prog_row.pack(side="top", fill="x")

        self.lbl_cur = ctk.CTkLabel(prog_row, text="0:00", font=F(11), text_color=C_TEXTO_GRIS)
        self.lbl_cur.pack(side="left", padx=(0, 10))
        
        # Slider "Flat" sin botón molesto
        self.prog = ctk.CTkSlider(prog_row, from_=0.0, to=1.0, height=4, corner_radius=2,
            fg_color="#2A2A2A", progress_color=C_TEXTO, button_color=C_TEXTO, button_length=0,
            command=self._on_seek)
        self.prog.set(0)
        self.prog.pack(side="left", fill="x", expand=True)
        self.prog.bind("<ButtonPress-1>",   lambda e: setattr(self, "_seeking", True))
        self.prog.bind("<ButtonRelease-1>", self._on_seek_release)
        
        self.lbl_tot = ctk.CTkLabel(prog_row, text="--:--", font=F(11), text_color=C_TEXTO_GRIS)
        self.lbl_tot.pack(side="right", padx=(10, 0))

        # 3. Derecha: Volumen
        right_col = ctk.CTkFrame(grid, fg_color="transparent", width=200)
        right_col.pack(side="right", fill="y", expand=False)
        right_col.pack_propagate(False)

        vol_row = ctk.CTkFrame(right_col, fg_color="transparent")
        vol_row.pack(side="right", pady=(28,0))
        ctk.CTkLabel(vol_row, text="🔈", font=F(14), text_color=C_TEXTO_GRIS).pack(side="left", padx=(0, 8))
        self.vol_slider = ctk.CTkSlider(vol_row, from_=0.0, to=1.0, width=100, height=4,
            corner_radius=2, fg_color="#2A2A2A", progress_color=C_TEXTO, button_length=0, command=self._set_volume)
        self.vol_slider.set(0.8)
        pygame.mixer.music.set_volume(0.8)
        self.vol_slider.pack(side="left")

        self._row_bars    = []
        self._row_bar_spd = []

    def _ctrl(self, p, t, c, sz=14):
        b = ctk.CTkButton(p, text=t, width=38, height=38, corner_radius=19,
            fg_color="transparent", hover_color=C_CARD, text_color=C_TEXTO_SUB,
            font=F(sz), border_width=0, command=c)
        b.pack(side="left", padx=2)
        return b

    def _tog(self, p, t, c):
        b = ctk.CTkButton(p, text=t, width=34, height=34, corner_radius=17,
            fg_color="transparent", hover_color=C_CARD, text_color=C_TEXTO_GRIS,
            font=F(15), border_width=0, command=c)
        b.pack(side="left", padx=2)
        return b

    def _build_refresh_btn(self):
        self.btn_ref = ctk.CTkButton(self, text="↺", width=36, height=36, corner_radius=18,
            fg_color="transparent", hover_color=C_CARD, text_color=C_TEXTO_GRIS,
            font=F(16), border_width=0, command=self._force_refresh)
        self.btn_ref.place(relx=1.0, rely=0.0, x=-16, y=16, anchor="ne")

    def _force_refresh(self):
        self._enforce_z()
        self.update_idletasks()
        self.update()
        if self._cur_view:
            try:
                self._cur_view.lift()
            except Exception:
                pass
        self.sidebar.lift()

    def _enforce_z(self):
        try:
            self.sidebar.lift()
            self.btn_ref.lift()
        except Exception:
            pass

    def _switch(self, builder_fn, nav_btn=None):
        if self._transitioning: return
        self._transitioning = True
        if nav_btn: self._set_nav(nav_btn)
        nuevo = ctk.CTkFrame(self.content, fg_color=C_FONDO, corner_radius=0)
        builder_fn(nuevo)
        nuevo.update_idletasks()
        nuevo.place(relx=0, rely=0, relwidth=1, relheight=1)
        nuevo.lift()
        viejo = self._cur_view
        self._cur_view = nuevo
        self._enforce_z()
        def _cleanup():
            if viejo:
                try: viejo.destroy()
                except Exception: pass
            self._transitioning = False
            self._enforce_z()
        self.after(5, _cleanup)

    def _switch_direct(self, builder_fn, nav_btn=None):
        if nav_btn: self._set_nav(nav_btn)
        nuevo = ctk.CTkFrame(self.content, fg_color=C_FONDO, corner_radius=0)
        builder_fn(nuevo)
        nuevo.update_idletasks()
        nuevo.place(relx=0, rely=0, relwidth=1, relheight=1)
        nuevo.lift()
        viejo = self._cur_view
        self._cur_view = nuevo
        self._enforce_z()
        if viejo:
            try: viejo.destroy()
            except Exception: pass

    # ══════════════════════════════════════════
    #  VISUALIZADOR Y PYGAME
    # ══════════════════════════════════════════
    def _tick_bars(self):
        self._animate_row_bars()

    def _animate_row_bars(self):
        if not self._playing or self._cur_idx < 0:
            self.after(200, self._animate_row_bars)
            return
        for row_idx, bars in enumerate(self._row_bars):
            if row_idx == self._cur_idx:
                for b in bars:
                    try: b.configure(height=random.randint(4, 22))
                    except Exception: pass
        self.after(80, self._animate_row_bars)

    def _pygame_loop(self):
        for ev in pygame.event.get():
            if ev.type == SONG_END:
                self._on_end()
        self.after(200, self._pygame_loop)

    def actualizar_barra(self):
        if self._playing and self._duration > 0 and not self._seeking:
            ms = pygame.mixer.music.get_pos()
            if ms >= 0:
                pos_real = min((ms / 1000.0) + self.inicio_tiempo_actual, self._duration)
                progreso = pos_real / self._duration
                try:
                    self.prog.set(progreso)
                    self.lbl_cur.configure(text=self._fmt(pos_real))
                except Exception:
                    pass
        self.after(500, self.actualizar_barra)

    def _on_seek(self, value: float):
        self._seeking = True
        if self._duration > 0:
            try: self.lbl_cur.configure(text=self._fmt(value * self._duration))
            except Exception: pass

    def _on_seek_release(self, event):
        if not self._playlist or self._cur_idx < 0 or self._duration <= 0:
            self._seeking = False
            return
        valor        = self.prog.get()
        nuevo_tiempo = valor * self._duration
        try:
            path = self._playlist[self._cur_idx]
            pygame.mixer.music.load(path)
            pygame.mixer.music.play(start=nuevo_tiempo)
            self.inicio_tiempo_actual = nuevo_tiempo
            self._playing = True
            self.btn_play.configure(text="⏸")
            self.lbl_cur.configure(text=self._fmt(nuevo_tiempo))
        except Exception as e:
            self.lbl_song.configure(text=f"✕ Error: {str(e)[:40]}")
        finally:
            self._seeking = False

    @staticmethod
    def _fmt(s: float) -> str:
        s = int(s)
        return f"{s//60}:{s%60:02d}"

    def _play_idx(self, idx: int):
        if not self._playlist or not (0 <= idx < len(self._playlist)): return
        self._cur_idx = idx
        path = self._playlist[idx]
        try:
            pygame.mixer.music.load(path)
            pygame.mixer.music.play()
            self._playing             = True
            self.inicio_tiempo_actual = 0.0
            self._duration = self._get_duration(path)
            name = os.path.basename(path).replace(".mp3", "").replace(".MP3", "")
            self.lbl_song.configure(text=name)
            self.btn_play.configure(text="⏸")
            self.prog.set(0)
            self.lbl_cur.configure(text="0:00")
            self.lbl_tot.configure(text=self._fmt(self._duration) if self._duration else "--:--")
            self._highlight(idx)
        except Exception:
            pass

    @staticmethod
    def _get_duration(path: str) -> float:
        try:
            from mutagen.mp3 import MP3
            return MP3(path).info.length
        except Exception:
            pass
        try:
            snd = pygame.mixer.Sound(path)
            dur = snd.get_length()
            del snd
            return dur
        except Exception:
            return 0.0

    def _toggle_play(self):
        if not self._playlist: return
        if self._playing:
            pygame.mixer.music.pause()
            self._playing = False
            self.btn_play.configure(text="▶")
        else:
            if self._cur_idx == -1: self._play_idx(0)
            else:
                pygame.mixer.music.unpause()
                self._playing = True
                self.btn_play.configure(text="⏸")

    def _next(self):
        if not self._playlist: return
        idx = random.randint(0, len(self._playlist) - 1) if self._shuffle else (self._cur_idx + 1) % len(self._playlist)
        self._play_idx(idx)

    def _prev(self):
        if not self._playlist: return
        self._play_idx((self._cur_idx - 1) % len(self._playlist))

    def _on_end(self):
        if self._loop: self._play_idx(self._cur_idx)
        else: self._next()

    def _toggle_loop(self):
        self._loop = not self._loop
        self.btn_loop.configure(text_color=C_TEXTO if self._loop else C_TEXTO_GRIS)

    def _toggle_shuffle(self):
        self._shuffle = not self._shuffle
        self.btn_shuf.configure(text_color=C_TEXTO if self._shuffle else C_TEXTO_GRIS)

    def _set_volume(self, value: float):
        pygame.mixer.music.set_volume(float(value))

    def _highlight(self, idx: int):
        for i, (card, lbl) in enumerate(self._row_refs):
            try:
                if i == idx:
                    card.configure(fg_color=C_ACTIVA)
                    lbl.configure(text_color=C_ACENTO_VIV)
                else:
                    card.configure(fg_color="transparent")
                    lbl.configure(text_color=C_TEXTO)
                    if i < len(self._row_bars):
                        for b in self._row_bars[i]: b.configure(height=3)
            except Exception:
                pass

    # ══════════════════════════════════════════
    #  PLAYLISTS DATA
    # ══════════════════════════════════════════
    def cargar_playlists(self):
        self.playlists = self._load_playlists()
        self._show_selection(animated=False)

    def _load_playlists(self) -> dict:
        result = {}
        if os.path.isdir(PLAYLISTS_DIR):
            for folder in sorted(os.listdir(PLAYLISTS_DIR)):
                fp = os.path.join(PLAYLISTS_DIR, folder)
                if os.path.isdir(fp):
                    files = sorted([os.path.join(fp, f) for f in os.listdir(fp) if f.lower().endswith(".mp3")])
                    result[folder] = files
        return result

    def _create_playlist(self):
        dialog = ctk.CTkInputDialog(text="Nombre de la nueva playlist:", title="Nueva Playlist")
        name = dialog.get_input()
        if not name or not name.strip(): return
        os.makedirs(os.path.join(PLAYLISTS_DIR, name.strip()), exist_ok=True)
        self.playlists = self._load_playlists()
        self._show_selection(animated=True)

    # ══════════════════════════════════════════
    #  VISTA 1 — SELECCIÓN
    # ══════════════════════════════════════════
    def _show_selection(self, animated: bool = True):
        def build(frame):
            top = ctk.CTkFrame(frame, fg_color="transparent")
            top.pack(fill="x", padx=36, pady=(40, 10))
            ctk.CTkLabel(top, text="Mi Biblioteca", font=F(32, "bold"), text_color=C_TEXTO).pack(side="left")
            ctk.CTkButton(top, text="+ Nueva", width=100, height=36, corner_radius=18,
                border_width=0, fg_color=C_TEXTO, hover_color=C_TEXTO_SUB,
                text_color=C_FONDO, font=F(14, "bold"), command=self._create_playlist).pack(side="right")

            pl_count = len(self.playlists)
            msg = f"{pl_count} listas" if pl_count else "No hay música todavía"
            ctk.CTkLabel(frame, text=msg, font=F(13), text_color=C_TEXTO_GRIS).pack(anchor="w", padx=36, pady=(0, 20))

            grid = ctk.CTkScrollableFrame(frame, fg_color="transparent",
                scrollbar_button_color=C_CARD, scrollbar_button_hover_color=C_ACENTO)
            grid.pack(fill="both", expand=True, padx=26, pady=(0, 20))

            cols = 4
            for i, (name, songs) in enumerate(self.playlists.items()):
                self._playlist_card(grid, name, songs, i // cols, i % cols)
            for c in range(cols):
                grid.columnconfigure(c, weight=1)

        if animated: self._switch(build, nav_btn=self.btn_playlists)
        else: self._switch_direct(build, nav_btn=self.btn_playlists)

    def _playlist_card(self, parent, name, songs, row, col):
        # Diseño cuadrado estilo Álbum
        card = ctk.CTkFrame(parent, fg_color=C_CARD, corner_radius=12, cursor="hand2")
        card.grid(row=row, column=col, padx=12, pady=12, sticky="nsew")
        
        # Simula la "portada" del álbum
        cover = ctk.CTkFrame(card, fg_color=C_PANEL, corner_radius=8, width=120, height=120)
        cover.pack(pady=(16, 10), padx=16)
        cover.pack_propagate(False)
        ico = ctk.CTkLabel(cover, text="♫", font=F(48), text_color=C_TEXTO_GRIS)
        ico.place(relx=0.5, rely=0.5, anchor="center")

        lbl = ctk.CTkLabel(card, text=name, font=F(15, "bold"), text_color=C_TEXTO, wraplength=130)
        lbl.pack(padx=16, anchor="w")
        sub = ctk.CTkLabel(card, text=f"{len(songs)} pistas", font=F(12), text_color=C_TEXTO_SUB)
        sub.pack(pady=(2, 16), padx=16, anchor="w")

        def enter(e, c=card, cv=cover): 
            c.configure(fg_color=C_CARD_HOVER)
            cv.configure(fg_color="#1F1F24")
        def leave(e, c=card, cv=cover): 
            c.configure(fg_color=C_CARD)
            cv.configure(fg_color=C_PANEL)
            
        for w in [card, cover, ico, lbl, sub]:
            w.bind("<Button-1>", lambda e, n=name: self._show_playlist(n))
            w.bind("<Enter>", enter)
            w.bind("<Leave>", leave)

    # ══════════════════════════════════════════
    #  VISTA 2 — PLAYLIST (SEAMLESS LIST)
    # ══════════════════════════════════════════
    def _show_playlist(self, name: str, animated: bool = True):
        songs = self.playlists.get(name, [])
        self._playlist              = songs
        self._all_songs             = songs
        self._current_playlist_name = name

        def build(frame):
            # 🪄 TRUCO DEL MAGO: La pantalla de carga
            self._cortina = ctk.CTkFrame(frame, fg_color=C_FONDO)
            self._cortina.place(relx=0, rely=0, relwidth=1, relheight=1)
            ctk.CTkLabel(self._cortina, text="Cargando biblioteca...", font=F(14), text_color=C_TEXTO_GRIS).place(relx=0.5, rely=0.5, anchor="center")
            frame.update_idletasks() # Forzamos a dibujar la cortina

            self._row_refs = []
            top = ctk.CTkFrame(frame, fg_color="transparent")
            top.pack(fill="x", padx=36, pady=(30, 10))
            
            back_btn = ctk.CTkButton(top, text="<", width=36, height=36, corner_radius=18,
                fg_color=C_CARD, hover_color=C_CARD_HOVER, text_color=C_TEXTO, font=F(16, "bold"),
                command=lambda: self._show_selection(animated=True))
            back_btn.pack(side="left")
            
            ctk.CTkLabel(top, text=f"  {name}", font=F(34, "bold"), text_color=C_TEXTO).pack(side="left", padx=10)

            self._lbl_meta = ctk.CTkLabel(frame,
                text=f"{len(songs)} canciones · {self._playlist_size(songs)}",
                font=F(12), text_color=C_TEXTO_GRIS)
            self._lbl_meta.pack(anchor="w", padx=90, pady=(0, 20))

            search_frame = ctk.CTkFrame(frame, fg_color="transparent")
            search_frame.pack(fill="x", padx=36, pady=(0, 10))
            self._search_var = ctk.StringVar()
            self._search_var.trace_add("write", lambda *_: self._filter_songs())
            self._search_entry = ctk.CTkEntry(search_frame, placeholder_text="Buscar en playlist...",
                textvariable=self._search_var, height=36, corner_radius=18, width=250,
                fg_color=C_ENTRY_BG, border_width=0, text_color=C_TEXTO, font=F(13))
            self._search_entry.pack(side="left")

            self._scroll_list = ctk.CTkScrollableFrame(frame, fg_color="transparent",
                scrollbar_button_color=C_CARD, scrollbar_button_hover_color=C_TEXTO_SUB)
            self._scroll_list.pack(fill="both", expand=True, padx=16, pady=(10, 10))
            
            # Construimos todo de golpe, ocultos tras la cortina
            self._build_song_rows(songs)
            self._highlight(self._cur_idx)

            # Destruimos la cortina
            self.after(200, self._cortina.destroy)

        if animated: self._switch(build, nav_btn=self.btn_playlists)
        else: self._switch_direct(build, nav_btn=self.btn_playlists)

    def _build_song_rows(self, songs: list):
        self._row_refs    = []
        self._row_bars    = []
        self._row_bar_spd = []
        for w in self._scroll_list.winfo_children():
            w.destroy()
        
        for i, path in enumerate(songs):
            row, lbl = self._skeleton_row(self._scroll_list, i, path)
            self._row_refs.append((row, lbl))

    def _filter_songs(self):
        query = self._search_var.get().strip().lower()
        filtered = [p for p in self._all_songs if query in os.path.basename(p).lower()] if query else self._all_songs
        self._playlist = filtered
        self._build_song_rows(filtered)
        self._highlight(self._cur_idx)

    def _skeleton_row(self, parent, idx: int, path: str):
        real = os.path.basename(path).replace(".mp3", "").replace(".MP3", "")
        
        # Diseño Seamless (Sin bordes, fondo transparente por defecto)
        card = ctk.CTkFrame(parent, fg_color="transparent", corner_radius=8, cursor="hand2", height=50)
        card.pack(fill="x", pady=2, padx=10)
        card.pack_propagate(False)
        
        ctk.CTkLabel(card, text=f"{idx + 1}", width=40, font=F(12), text_color=C_TEXTO_NUM).pack(side="left", padx=(10, 4))
        
        lbl = ctk.CTkLabel(card, text=real, font=F(14), text_color=C_TEXTO, anchor="w")
        lbl.pack(side="left", fill="x", expand=True, padx=(10, 8))
        
        viz = ctk.CTkFrame(card, fg_color="transparent", width=40, height=50)
        viz.pack(side="right", padx=(0, 10))
        viz.pack_propagate(False)
        
        bars_this_row = []
        for _ in range(4):
            b = ctk.CTkFrame(viz, width=3, height=3, fg_color=C_ACENTO_VIV, corner_radius=2)
            b.pack(side="left", padx=1, anchor="center")
            bars_this_row.append(b)
            
        while len(self._row_bars) <= idx:
            self._row_bars.append([])
            self._row_bar_spd.append(80)
            
        self._row_bars[idx] = bars_this_row
        
        lbl_dur = ctk.CTkLabel(card, text="--:--", font=F(12), text_color=C_TEXTO_GRIS, width=45)
        lbl_dur.pack(side="right", padx=(0, 10))
        
        btn_opts = ctk.CTkButton(card, text="⋮", width=30, height=30, corner_radius=15,
            fg_color="transparent", hover_color=C_TEXTO_SUB, text_color=C_TEXTO_GRIS,
            font=F(16), command=lambda i=idx, p=path: self._show_song_menu(i, p))
        btn_opts.pack(side="right", padx=(0, 10))
        
        def on_enter(e, c=card, i=idx):
            if i != self._cur_idx: c.configure(fg_color=C_CARD_HOVER)
        def on_leave(e, c=card, i=idx):
            if i != self._cur_idx: c.configure(fg_color="transparent")
        def on_click(e, i=idx): self._play_idx(i)
        
        no_click = {btn_opts}
        for w in [card, lbl] + [ch for ch in card.winfo_children() if ch not in no_click]:
            w.bind("<Button-1>", on_click)
            w.bind("<Enter>",    on_enter)
            w.bind("<Leave>",    on_leave)

        def _cargar_duracion():
            dur = self._get_duration(path)
            self.after(0, lambda: lbl_dur.configure(text=self._fmt(dur)))
        self._thread_pool.submit(_cargar_duracion)
            
        return card, lbl

    def _show_song_menu(self, idx, path):
        nombre = os.path.basename(path).replace(".mp3", "").replace(".MP3", "")
        popup = ctk.CTkToplevel(self)
        popup.title("Opciones")
        popup.geometry("300x180")
        popup.resizable(False, False)
        popup.configure(fg_color=C_PANEL)
        popup.grab_set()
        popup.lift()
        self.update_idletasks()
        px = self.winfo_x() + (self.winfo_width()  - 300) // 2
        py = self.winfo_y() + (self.winfo_height() - 180) // 2
        popup.geometry(f"300x180+{px}+{py}")
        ctk.CTkLabel(popup, text=nombre, font=F(13, "bold"), text_color=C_TEXTO, wraplength=260).pack(pady=(20, 4), padx=20)
        ctk.CTkButton(popup, text="🗑  Eliminar canción", height=38, corner_radius=10,
            fg_color="#7B1D1D", hover_color="#B71C1C", text_color=C_TEXTO, font=F(13),
            command=lambda: self._delete_song(idx, path, popup)).pack(fill="x", padx=24, pady=(15, 8))
        ctk.CTkButton(popup, text="Cancelar", height=34, corner_radius=10,
            fg_color=C_CARD, hover_color=C_CARD_HOVER, text_color=C_TEXTO_GRIS,
            font=F(12), command=popup.destroy).pack(fill="x", padx=24)

    def _delete_song(self, idx, path, popup):
        popup.destroy()
        if self._cur_idx == idx and self._playing:
            pygame.mixer.music.stop()
            self._playing = False; self._cur_idx = -1; self._duration = 0.0; self._seeking = False
            self.btn_play.configure(text="▶")
            self.prog.set(0)
            self.lbl_cur.configure(text="0:00"); self.lbl_tot.configure(text="--:--")
            self.lbl_song.configure(text="Sin reproducción")
        try: os.remove(path)
        except Exception as e: return
        self.playlists = self._load_playlists()
        current = self._current_playlist_name
        if current and current in self.playlists:
            songs = self.playlists[current]
            self._playlist = songs; self._all_songs = songs
            self._build_song_rows(songs)
            self._update_playlist_meta(songs)
        else:
            self._show_selection(animated=False)

    @staticmethod
    def _playlist_size(songs):
        total = sum(os.path.getsize(p) for p in songs if os.path.exists(p))
        if total == 0: return "0 MB"
        if total < 1024 * 1024: return f"{total / 1024:.1f} KB"
        return f"{total / (1024 * 1024):.1f} MB"

    def _update_playlist_meta(self, songs):
        try: self._lbl_meta.configure(text=f"{len(songs)} canciones · {self._playlist_size(songs)}")
        except Exception: pass

    # ══════════════════════════════════════════
    #  VISTA 3 — DESCARGA + BUSCADOR
    # ══════════════════════════════════════════
    def _goto_download(self):
        def build(frame):
            ctk.CTkLabel(frame, text="Descubrir y Descargar",
                font=F(32, "bold"), text_color=C_TEXTO).pack(anchor="w", padx=36, pady=(40, 2))
            ctk.CTkLabel(frame, text="Buscá en YouTube o pegá un enlace directo.",
                font=F(13), text_color=C_TEXTO_GRIS).pack(anchor="w", padx=36, pady=(0, 20))

            sc = ctk.CTkScrollableFrame(frame, fg_color="transparent", scrollbar_button_color=C_CARD)
            sc.pack(fill="both", expand=True, padx=20, pady=(0, 10))

            # BUSCADOR
            card_search = ctk.CTkFrame(sc, fg_color=C_PANEL, corner_radius=12)
            card_search.pack(fill="x", padx=16, pady=(0, 20))

            row_search = ctk.CTkFrame(card_search, fg_color="transparent")
            row_search.pack(fill="x", padx=20, pady=20)

            self._yt_query_entry = ctk.CTkEntry(row_search, placeholder_text="Ej: Brazilian Phonk...",
                height=44, corner_radius=22, fg_color=C_ENTRY_BG, border_width=0,
                text_color=C_TEXTO, placeholder_text_color=C_TEXTO_GRIS, font=F(14))
            self._yt_query_entry.pack(side="left", fill="x", expand=True, padx=(0, 10))
            self._yt_query_entry.bind("<Return>", lambda e: self._iniciar_busqueda())

            self._btn_buscar = ctk.CTkButton(row_search, text="Buscar", width=100, height=44,
                corner_radius=22, border_width=0, fg_color=C_TEXTO, hover_color=C_TEXTO_SUB,
                text_color=C_FONDO, font=F(14, "bold"), command=self._iniciar_busqueda)
            self._btn_buscar.pack(side="right")

            self._lbl_search_status = ctk.CTkLabel(card_search, text="", font=F(12), text_color=C_TEXTO_GRIS)
            self._lbl_search_status.pack(anchor="w", padx=20, pady=(0, 10))

            self._search_results_frame = ctk.CTkScrollableFrame(card_search, fg_color="transparent", height=200)
            self._search_results_frame.pack(fill="x", padx=10, pady=(0, 10))

            # DESCARGA DIRECTA
            card_dl = ctk.CTkFrame(sc, fg_color=C_PANEL, corner_radius=12)
            card_dl.pack(fill="x", padx=16, pady=(0, 20))

            ctk.CTkLabel(card_dl, text="Descarga Directa", font=F(16, "bold"), text_color=C_TEXTO).pack(anchor="w", padx=24, pady=(20, 10))

            self._url_entry = ctk.CTkEntry(card_dl, placeholder_text="https://www.youtube.com/watch?v=...",
                height=44, corner_radius=8, fg_color=C_ENTRY_BG, border_width=0, text_color=C_TEXTO, font=F(13))
            self._url_entry.pack(fill="x", padx=24, pady=(0, 20))

            row_playlist = ctk.CTkFrame(card_dl, fg_color="transparent")
            row_playlist.pack(fill="x", padx=24, pady=(0, 20))
            ctk.CTkLabel(row_playlist, text="Guardar en:", font=F(14), text_color=C_TEXTO_SUB).pack(side="left")
                
            pl_names = list(self.playlists.keys()) if self.playlists else ["(sin playlists)"]
            self._dest_var = ctk.StringVar(value=pl_names[0])
            ctk.CTkOptionMenu(row_playlist, values=pl_names, variable=self._dest_var,
                height=38, corner_radius=8, fg_color=C_CARD, button_color=C_CARD, button_hover_color=C_CARD_HOVER,
                text_color=C_TEXTO, font=F(13)).pack(side="right")

            self._btn_dl = ctk.CTkButton(card_dl, text="Descargar Audio", height=48, corner_radius=24, 
                fg_color=C_ACENTO, hover_color=C_ACENTO_H, text_color=C_TEXTO, font=F(15, "bold"), command=self._start_download)
            self._btn_dl.pack(fill="x", padx=24, pady=(10, 20))

            self._dl_prog = ctk.CTkProgressBar(card_dl, height=4, corner_radius=2, fg_color=C_ENTRY_BG, progress_color=C_ACENTO)
            self._dl_prog.set(0)
            self._dl_prog.pack(fill="x", padx=24, pady=(0, 10))

            self._dl_status = ctk.CTkLabel(card_dl, text="Listo para descargar", font=F(12), text_color=C_TEXTO_GRIS)
            self._dl_status.pack(pady=(0, 20))

        self._switch(build, nav_btn=self.btn_download)

    def _iniciar_busqueda(self):
        query = self._yt_query_entry.get().strip()
        if not query: return
        self._btn_buscar.configure(state="disabled", text="...")
        self._lbl_search_status.configure(text="Buscando...", text_color=C_TEXTO_GRIS)
        for w in self._search_results_frame.winfo_children(): w.destroy()
        threading.Thread(target=self.ejecutar_busqueda, args=(query,), daemon=True).start()

    def ejecutar_busqueda(self, query: str):
        try: import yt_dlp
        except ImportError:
            self.after(0, lambda: self._btn_buscar.configure(state="normal", text="Buscar"))
            return
        opts = {"extract_flat": True, "quiet": True, "no_warnings": True, "ignoreerrors": True, "nocheckcertificate": True}
        if os.path.isfile(self.cookies_file): opts["cookiefile"] = self.cookies_file
        resultados = []
        try:
            with yt_dlp.YoutubeDL(opts) as ydl:
                info = ydl.extract_info(f"ytsearch5:{query}", download=False)
            if info and "entries" in info:
                for entry in info["entries"]:
                    if entry: resultados.append({
                        "titulo": entry.get("title", "Sin título"), "canal": entry.get("uploader", ""),
                        "duracion": entry.get("duration") or 0, "url": f"https://www.youtube.com/watch?v={entry.get('id', '')}"
                    })
            if resultados: self.after(0, lambda r=resultados: self._mostrar_resultados(r))
            else: self.after(0, lambda: self._lbl_search_status.configure(text="Sin resultados.", text_color="#FFB300"))
        except Exception: pass
        finally: self.after(0, lambda: self._btn_buscar.configure(state="normal", text="Buscar"))

    def _mostrar_resultados(self, resultados: list):
        for w in self._search_results_frame.winfo_children(): w.destroy()
        self._lbl_search_status.configure(text=f"{len(resultados)} resultados", text_color=C_TEXTO_SUB)
        for res in resultados:
            dur_str = self._fmt(res["duracion"]) if res["duracion"] else "--:--"
            card = ctk.CTkFrame(self._search_results_frame, fg_color=C_CARD, corner_radius=8)
            card.pack(fill="x", pady=4, padx=4)
            row = ctk.CTkFrame(card, fg_color="transparent")
            row.pack(fill="x", padx=16, pady=12)
            col = ctk.CTkFrame(row, fg_color="transparent")
            col.pack(side="left", fill="x", expand=True)
            ctk.CTkLabel(col, text=res["titulo"], font=F(13, "bold"), text_color=C_TEXTO, anchor="w").pack(anchor="w")
            ctk.CTkLabel(col, text=res["canal"], font=F(11), text_color=C_TEXTO_GRIS, anchor="w").pack(anchor="w")
            ctk.CTkLabel(row, text=dur_str, font=F(12), text_color=C_TEXTO_GRIS).pack(side="right", padx=(0, 16))
            ctk.CTkButton(row, text="Preparar", width=80, height=30, corner_radius=15, fg_color=C_TEXTO, hover_color=C_TEXTO_SUB,
                text_color=C_FONDO, font=F(12, "bold"), command=lambda u=res["url"]: self._preparar_descarga(u)).pack(side="right")

    def _preparar_descarga(self, url: str):
        try:
            self._url_entry.delete(0, "end")
            self._url_entry.insert(0, url)
            self._lbl_search_status.configure(text="URL copiada abajo. Presioná Descargar Audio.", text_color="#66BB6A")
        except Exception: pass

    def _start_download(self):
        url = self._url_entry.get().strip()
        if not url: return
        dest_name = self._dest_var.get()
        if dest_name == "(sin playlists)": return
        dest_path = os.path.join(PLAYLISTS_DIR, dest_name)
        os.makedirs(dest_path, exist_ok=True)
        self._btn_dl.configure(state="disabled")
        self._dl_prog.set(0)
        self._dl_status.configure(text="Iniciando...", text_color=C_TEXTO_GRIS)
        threading.Thread(target=self._download_worker, args=(url, dest_path), daemon=True).start()

    def _download_worker(self, url: str, dest_path: str):
        try: import yt_dlp
        except ImportError:
            self.after(0, lambda: self._btn_dl.configure(state="normal"))
            return
        def hook(d):
            if d.get("status") == "downloading":
                total = d.get("total_bytes") or d.get("total_bytes_estimate") or 0
                done  = d.get("downloaded_bytes", 0)
                if total: self.after(0, lambda p=done/total: self._dl_prog.set(p))
                self.after(0, lambda: self._dl_status.configure(text="Descargando audio..."))
            elif d.get("status") == "finished":
                self.after(0, lambda: self._dl_prog.set(0.95))
                self.after(0, lambda: self._dl_status.configure(text="Procesando..."))

        opts = {
            "format": "bestaudio/best",
            "outtmpl": os.path.join(dest_path, "%(title)s.%(ext)s"),
            "postprocessors": [{"key": "FFmpegExtractAudio", "preferredcodec": "mp3", "preferredquality": "192"}],
            "progress_hooks": [hook], "ignoreerrors": True, "nocheckcertificate": True, "quiet": True,
            "sleep_interval": 3, "max_sleep_interval": 7,
            "extractor_args": {"youtube": {"player_client": ["android", "web"]}},
            "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/131.0.0.0 Safari/537.36"}
        }
        if os.path.isfile(self.cookies_file): opts["cookiefile"] = self.cookies_file
        if os.path.isfile(FFMPEG_PATH): opts["ffmpeg_location"] = os.path.dirname(FFMPEG_PATH)

        try:
            with yt_dlp.YoutubeDL(opts) as ydl: ydl.download([url])
            self.playlists = self._load_playlists()
            self.after(0, lambda: self._dl_prog.set(1.0))
            self.after(0, lambda: self._dl_status.configure(text="¡Descarga completada!", text_color="#66BB6A"))
            self._url_entry.delete(0, "end")
        except Exception as e:
            self.after(0, lambda: self._dl_status.configure(text="Falló la descarga.", text_color=C_ACENTO))
        finally:
            self.after(0, lambda: self._btn_dl.configure(state="normal"))

    # ══════════════════════════════════════════
    def _goto_selection(self): self._show_selection(animated=True)
    def _set_nav(self, active):
        for b in [self.btn_playlists, self.btn_download]: b.configure(fg_color="transparent", text_color=C_TEXTO_SUB)
        active.configure(fg_color=C_CARD, text_color=C_TEXTO)
    def destroy(self):
        try: pygame.mixer.music.stop(); pygame.quit()
        except Exception: pass
        super().destroy()

if __name__ == "__main__":
    ctk.set_appearance_mode("dark")
    app = ReproductorApp()
    app.mainloop()